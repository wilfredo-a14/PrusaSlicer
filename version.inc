# Included by CMakeLists. The application version is maintained in VERSION.

set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/VERSION")
file(READ "${CMAKE_CURRENT_LIST_DIR}/VERSION" SLIC3R_VERSION)
string(STRIP "${SLIC3R_VERSION}" SLIC3R_VERSION)
if (NOT SLIC3R_VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
    message(FATAL_ERROR "VERSION must contain a semantic version such as 1.0.0")
endif ()

set(SLIC3R_VERSION_MAJOR "${CMAKE_MATCH_1}")
set(SLIC3R_VERSION_MINOR "${CMAKE_MATCH_2}")
set(SLIC3R_VERSION_PATCH "${CMAKE_MATCH_3}")

set(SLIC3R_APP_NAME "DeSimoneLab printing")
set(SLIC3R_APP_KEY "PrusaSlicer")
set(SLIC3R_BUILD_ID "${SLIC3R_APP_NAME}-${SLIC3R_VERSION}")
set(SLIC3R_RC_VERSION "${SLIC3R_VERSION_MAJOR},${SLIC3R_VERSION_MINOR},${SLIC3R_VERSION_PATCH},0")
set(SLIC3R_RC_VERSION_DOTS "${SLIC3R_VERSION}.0")
